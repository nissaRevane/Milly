.bundle
# Ignore every log, rotated ones included: log/test.log.0 reached 100 MB and got
# committed once because `log/*.log` does not match a rotated suffix.
log/*
!log/.keep
tmp/
db/*.sqlite3
db/*.sqlite3-journal
storage/
config/master.key
config/credentials/*.key
public/sprockets
node_modules/
.env
.memorai

# Secrets Kamal en local (le fichier .kamal/secrets, lui, est versionne)
.kamal/env.local
