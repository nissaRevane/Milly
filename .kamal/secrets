# Ce fichier est versionne : il ne contient que des *references* a des variables
# d'environnement, jamais les valeurs elles-memes.
#
# En CI, GitHub Actions injecte ces variables depuis les secrets du depot.
# En local, cree un fichier .kamal/env.local (ignore par git) et source-le :
#
#   set -a; source .kamal/env.local; set +a
#   bin/kamal deploy

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
SMTP_PASSWORD=$SMTP_PASSWORD
