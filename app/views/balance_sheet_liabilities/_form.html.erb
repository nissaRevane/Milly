<%= form_with(model: [@balance_sheet, balance_sheet_liability], class: "form", data: { controller: "suggested-value" }) do |f| %>
  <% if balance_sheet_liability.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% balance_sheet_liability.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%#
    Chaque option porte le montant à proposer pour cette dette : le capital restant dû
    dérivé du tableau d'amortissement à la date de clôture du bilan
    (Liability#suggested_remaining_capital). Le contrôleur suggested-value le recopie
    dans le champ montant à la sélection.
  %>
  <div class="form-group">
    <%= f.label :liability_id, t("views.balance_sheet_liabilities.form.liability") %>
    <%= f.select :liability_id,
                 @available_liabilities.map { |liability| [liability.name, liability.id, { data: { suggested_value: suggested_value_attribute(liability.suggested_remaining_capital(@balance_sheet.closing_date)) } }] },
                 { prompt: "-- Sélectionner une dette --" },
                 class: "form-control",
                 data: { suggested_value_target: "source", action: "change->suggested-value#apply" } %>
  </div>

  <div class="form-group">
    <%= f.label :remaining_capital, t("views.balance_sheet_liabilities.form.remaining_capital") %>
    <%= f.number_field :remaining_capital, step: 0.01, min: 0, class: "form-control", required: true,
                       data: { suggested_value_target: "value" } %>
    <small class="form-hint"><%= t("views.balance_sheet_liabilities.form.remaining_capital_hint") %></small>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", balance_sheet_path(@balance_sheet), class: "btn btn-outline" %>
  </div>
<% end %>
