<%= form_with(model: [@balance_sheet, balance_sheet_asset], class: "form", data: { controller: "suggested-value" }) do |f| %>
  <% if balance_sheet_asset.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% balance_sheet_asset.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%#
    Chaque option porte la valeur à proposer pour cet actif (Asset#suggested_value) : le
    contrôleur suggested-value la recopie dans le champ montant à la sélection.
  %>
  <div class="form-group">
    <%= f.label :asset_id, t("views.balance_sheet_assets.form.asset") %>
    <%= f.select :asset_id,
                 @available_assets.map { |asset| [asset.name, asset.id, { data: { suggested_value: suggested_value_attribute(asset.suggested_value) } }] },
                 { prompt: "-- Sélectionner un actif --" },
                 class: "form-control",
                 data: { suggested_value_target: "source", action: "change->suggested-value#apply" } %>
  </div>

  <div class="form-group">
    <%= f.label :value, t("views.balance_sheet_assets.form.value") %>
    <%= f.number_field :value, step: 0.01, min: 0, class: "form-control", required: true,
                       data: { suggested_value_target: "value" } %>
    <small class="form-hint"><%= t("views.balance_sheet_assets.form.value_hint") %></small>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", balance_sheet_path(@balance_sheet), class: "btn btn-outline" %>
  </div>
<% end %>
