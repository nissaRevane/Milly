<%#
  Transversal re-reading of the balance sheet, one block per bien immobilier.

  The lines shown here are the SAME ones already listed in the actifs and passifs
  columns of the synthèse tab: the redundancy is deliberate. Those columns answer
  "what do I own and what do I owe", this band answers "what does this bien weigh,
  net of its debt" — a control-of-input view over existing data, never new data.
%>
<% if positions.any? %>
  <div class="section property-positions">
    <div class="section-header">
      <h2><%= t("views.balance_sheets.properties.title") %></h2>
    </div>

    <div class="cards-grid">
      <% positions.each do |position| %>
        <div class="card property-card <%= "property-card-unassigned" if position.unassigned? %>">
          <div class="card-header property-card-header">
            <h3>
              <%= position.unassigned? ? t("views.balance_sheets.properties.unassigned") : position.property.name %>
            </h3>
            <% if position.unassigned? %>
              <%# Warning-styled on purpose: this block exists to nudge the user into linking these lines %>
              <span class="badge badge-warning"><%= t("views.balance_sheets.properties.to_link") %></span>
            <% else %>
              <span class="badge badge-secondary"><%= position.property.usage_label %></span>
            <% end %>
          </div>

          <% if position.unassigned? %>
            <p class="property-card-hint"><%= t("views.balance_sheets.properties.unassigned_hint") %></p>
          <% end %>

          <table class="table table-compact">
            <tbody>
              <% position.asset_lines.each do |bsa| %>
                <tr>
                  <td>
                    <div class="cell-title"><%= bsa.asset.name %></div>
                    <span class="badge <%= risk_level_badge_class(bsa.asset.risk_level) %>" title="<%= risk_level_label(bsa.asset.risk_level) %>">
                      <%= bsa.asset.asset_type_label %>
                    </span>
                  </td>
                  <td class="text-right"><%= number_to_currency(bsa.owned_value) %></td>
                </tr>
              <% end %>

              <% position.liability_lines.each do |bsl| %>
                <tr>
                  <td>
                    <div class="cell-title"><%= bsl.liability.name %></div>
                    <span class="badge <%= risk_level_badge_class(bsl.liability.risk_level) %>" title="<%= risk_level_label(bsl.liability.risk_level) %>">
                      <%= bsl.liability.liability_type_label %>
                    </span>
                  </td>
                  <%# Shown as a negative: the block reads as a single running total down to the net value %>
                  <td class="text-right text-danger"><%= number_to_currency(-bsl.owned_remaining_capital) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="card-footer property-card-net">
            <span><%= t("views.balance_sheets.properties.net") %></span>
            <span><%= number_to_currency(position.net) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
