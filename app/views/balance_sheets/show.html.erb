<div class="page-header">
  <%= render layout: "balance_sheets/sheet_nav",
             locals: { previous: @previous,
                       following: @following,
                       previous_path: (balance_sheet_path(@previous) if @previous),
                       following_path: (balance_sheet_path(@following) if @following),
                       scope: "views.balance_sheets.show" } do %>
    <%# Cette page EST l'édition du bilan : la date de clôture s'y corrige sur place,
        au même geste que les montants des lignes, plutôt que sur un formulaire à part. %>
    <div data-controller="inline-edit">
      <h1 data-inline-edit-target="display">
        <button type="button" class="inline-edit-trigger inline-edit-trigger-title"
                data-action="inline-edit#edit"
                title="<%= t("views.balance_sheets.show.click_to_edit_date") %>">
          <%= t("views.balance_sheets.show.title", date: l(@balance_sheet.closing_date, format: :long)) %>
        </button>
      </h1>
      <%= form_with model: @balance_sheet, class: "inline-edit-form",
                    data: { inline_edit_target: "form", action: "submit->inline-edit#markSubmitting" },
                    html: { hidden: true } do |f| %>
        <%= f.date_field :closing_date, required: true,
              class: "inline-edit-input inline-edit-input-title",
              data: inline_edit_input_data %>
      <% end %>
    </div>
  <% end %>
  <div class="page-header-actions">
    <%= link_to t("views.balance_sheets.index.summary"), summary_balance_sheet_path(@balance_sheet), class: "btn btn-primary" %>
  </div>
</div>

<div class="balance-sheet-detail">
  <!-- Assets and liabilities: side by side on wide screens, stacked below -->
  <div class="balance-sheet-columns">
    <!-- Assets Section -->
    <div class="section">
      <div class="section-header">
        <h2><%= t("views.balance_sheets.show.assets") %></h2>
        <%= link_to t("views.balance_sheets.show.add_asset"), new_balance_sheet_balance_sheet_asset_path(@balance_sheet), class: "btn btn-sm btn-primary" %>
      </div>

      <% if @assets_by_type.any? %>
        <div class="table-scroll">
          <table class="table">
            <tbody>
              <% Asset.asset_types.keys.each do |type| %>
                <% items = @assets_by_type.fetch(type, []) %>
                <% next if items.empty? %>

                <tr class="table-group-header">
                  <td>
                    <span class="badge badge-secondary"><%= asset_type_label(type) %></span>
                    <span class="summary-category-count"><%= items.size %></span>
                  </td>
                  <td class="text-right table-group-amount"><%= number_to_currency(items.sum(&:owned_value)) %></td>
                  <td></td>
                </tr>
                <% items.each do |bsa| %>
                  <tr>
                    <td>
                      <div class="cell-title"><%= bsa.asset.name %></div>
                    </td>
                    <td class="text-right">
                      <div data-controller="inline-edit">
                        <button type="button" class="inline-edit-trigger" data-inline-edit-target="display"
                                data-action="inline-edit#edit"
                                title="<%= t("views.balance_sheets.show.click_to_edit") %>">
                          <%= owned_value_cell(bsa.value, bsa.owned_value, bsa.asset.ownership_share) %>
                        </button>
                        <%= form_with model: [@balance_sheet, bsa], class: "inline-edit-form",
                                      data: { inline_edit_target: "form", action: "submit->inline-edit#markSubmitting" },
                                      html: { hidden: true } do |f| %>
                          <%= f.number_field :value, step: "0.01", min: "0", required: true,
                                value: suggested_value_attribute(bsa.value),
                                class: "inline-edit-input",
                                data: inline_edit_input_data %>
                        <% end %>
                      </div>
                    </td>
                    <td class="table-actions">
                      <%= button_to "🗑️", balance_sheet_balance_sheet_asset_path(@balance_sheet, bsa), method: :delete, class: "btn btn-sm btn-danger",
                          form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="section-total">
          <span><%= t("views.balance_sheets.show.total_assets") %></span>
          <span><%= number_to_currency(@balance_sheet.total_assets) %></span>
        </div>
      <% else %>
        <p class="empty-state">Aucun actif dans ce bilan.</p>
      <% end %>
    </div>

    <!-- Liabilities Section -->
    <div class="section">
      <div class="section-header">
        <h2><%= t("views.balance_sheets.show.liabilities") %></h2>
        <%= link_to t("views.balance_sheets.show.add_liability"), new_balance_sheet_balance_sheet_liability_path(@balance_sheet), class: "btn btn-sm btn-primary" %>
      </div>

      <% if @liabilities_by_type.any? %>
        <div class="table-scroll">
          <table class="table">
            <tbody>
              <% Liability.liability_types.keys.each do |type| %>
                <% items = @liabilities_by_type.fetch(type, []) %>
                <% next if items.empty? %>

                <tr class="table-group-header">
                  <td>
                    <span class="badge badge-secondary"><%= liability_type_label(type) %></span>
                    <span class="summary-category-count"><%= items.size %></span>
                  </td>
                  <td class="text-right table-group-amount"><%= number_to_currency(items.sum(&:owned_remaining_capital)) %></td>
                  <td></td>
                </tr>
                <% items.each do |bsl| %>
                  <tr>
                    <td>
                      <div class="cell-title"><%= bsl.liability.name %></div>
                    </td>
                    <td class="text-right">
                      <div data-controller="inline-edit">
                        <button type="button" class="inline-edit-trigger" data-inline-edit-target="display"
                                data-action="inline-edit#edit"
                                title="<%= t("views.balance_sheets.show.click_to_edit") %>">
                          <%= owned_value_cell(bsl.remaining_capital, bsl.owned_remaining_capital, bsl.liability.ownership_share) %>
                        </button>
                        <%= form_with model: [@balance_sheet, bsl], class: "inline-edit-form",
                                      data: { inline_edit_target: "form", action: "submit->inline-edit#markSubmitting" },
                                      html: { hidden: true } do |f| %>
                          <%= f.number_field :remaining_capital, step: "0.01", min: "0", required: true,
                                value: suggested_value_attribute(bsl.remaining_capital),
                                class: "inline-edit-input",
                                data: inline_edit_input_data %>
                        <% end %>
                      </div>
                    </td>
                    <td class="table-actions">
                      <%= button_to "🗑️", balance_sheet_balance_sheet_liability_path(@balance_sheet, bsl), method: :delete, class: "btn btn-sm btn-danger",
                          form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="section-total">
          <span><%= t("views.balance_sheets.show.total_liabilities") %></span>
          <span><%= number_to_currency(@balance_sheet.total_liabilities) %></span>
        </div>
      <% else %>
        <p class="empty-state">Aucun passif dans ce bilan.</p>
      <% end %>
    </div>
  </div>

  <!-- Equity -->
  <div class="equity-box <%= @balance_sheet.equity >= 0 ? 'equity-positive' : 'equity-negative' %>">
    <span class="equity-label"><%= t("views.balance_sheets.show.equity") %></span>
    <span class="equity-value"><%= number_to_currency(@balance_sheet.equity) %></span>
  </div>
</div>

<div class="form-actions">
  <%= link_to t("views.balance_sheets.show.back"), balance_sheets_path, class: "btn btn-outline" %>
</div>
