<div class="page-header">
  <h1><%= t("views.balance_sheets.show.title", date: l(@balance_sheet.closing_date, format: :long)) %></h1>
  <div class="page-header-actions">
    <%= link_to t("views.balance_sheets.index.summary"), summary_balance_sheet_path(@balance_sheet), class: "btn btn-primary" %>
    <%= link_to t("views.balance_sheets.show.edit"), edit_balance_sheet_path(@balance_sheet), class: "btn btn-outline" %>
  </div>
</div>

<div class="balance-sheet-detail">
  <!-- Assets and liabilities: side by side on wide screens, stacked below -->
  <div class="balance-sheet-columns">
    <!-- Assets Section -->
    <div class="section">
      <div class="section-header">
        <h2><%= t("views.balance_sheets.show.assets") %></h2>
        <%= link_to t("views.balance_sheets.show.add_asset"), new_balance_sheet_balance_sheet_asset_path(@balance_sheet), class: "btn btn-sm btn-primary" %>
      </div>

      <% if @balance_sheet_assets.any? %>
        <div class="table-scroll">
          <table class="table">
            <tbody>
              <% @balance_sheet_assets.each do |bsa| %>
                <tr>
                  <td>
                    <div class="cell-title"><%= bsa.asset.name %></div>
                    <span class="badge <%= risk_level_badge_class(bsa.asset.risk_level) %>" title="<%= risk_level_label(bsa.asset.risk_level) %>">
                      <%= bsa.asset.asset_type_label %>
                    </span>
                  </td>
                  <td class="text-right"><%= owned_value_cell(bsa.value, bsa.owned_value, bsa.asset.ownership_share) %></td>
                  <td class="table-actions">
                    <%= link_to "✏️", edit_balance_sheet_balance_sheet_asset_path(@balance_sheet, bsa), class: "btn btn-sm btn-outline" %>
                    <%= button_to "🗑️", balance_sheet_balance_sheet_asset_path(@balance_sheet, bsa), method: :delete, class: "btn btn-sm btn-danger",
                        form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="section-total">
          <span><%= t("views.balance_sheets.show.total_assets") %></span>
          <span><%= number_to_currency(@balance_sheet.total_assets) %></span>
        </div>
      <% else %>
        <p class="empty-state">Aucun actif dans ce bilan.</p>
      <% end %>
    </div>

    <!-- Liabilities Section -->
    <div class="section">
      <div class="section-header">
        <h2><%= t("views.balance_sheets.show.liabilities") %></h2>
        <%= link_to t("views.balance_sheets.show.add_liability"), new_balance_sheet_balance_sheet_liability_path(@balance_sheet), class: "btn btn-sm btn-primary" %>
      </div>

      <% if @balance_sheet_liabilities.any? %>
        <div class="table-scroll">
          <table class="table">
            <tbody>
              <% @balance_sheet_liabilities.each do |bsl| %>
                <tr>
                  <td>
                    <div class="cell-title"><%= bsl.liability.name %></div>
                    <span class="badge <%= risk_level_badge_class(bsl.liability.risk_level) %>" title="<%= risk_level_label(bsl.liability.risk_level) %>">
                      <%= bsl.liability.liability_type_label %>
                    </span>
                  </td>
                  <td class="text-right"><%= owned_value_cell(bsl.remaining_capital, bsl.owned_remaining_capital, bsl.liability.ownership_share) %></td>
                  <td class="table-actions">
                    <%= link_to "✏️", edit_balance_sheet_balance_sheet_liability_path(@balance_sheet, bsl), class: "btn btn-sm btn-outline" %>
                    <%= button_to "🗑️", balance_sheet_balance_sheet_liability_path(@balance_sheet, bsl), method: :delete, class: "btn btn-sm btn-danger",
                        form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="section-total">
          <span><%= t("views.balance_sheets.show.total_liabilities") %></span>
          <span><%= number_to_currency(@balance_sheet.total_liabilities) %></span>
        </div>
      <% else %>
        <p class="empty-state">Aucun passif dans ce bilan.</p>
      <% end %>
    </div>
  </div>

  <!-- Real estate, regrouped per property: full width, it reunites both columns -->
  <%= render "property_positions", positions: @property_positions %>

  <!-- Equity -->
  <div class="equity-box <%= @balance_sheet.equity >= 0 ? 'equity-positive' : 'equity-negative' %>">
    <span class="equity-label"><%= t("views.balance_sheets.show.equity") %></span>
    <span class="equity-value"><%= number_to_currency(@balance_sheet.equity) %></span>
  </div>
</div>

<div class="form-actions">
  <%= link_to t("views.balance_sheets.show.back"), balance_sheets_path, class: "btn btn-outline" %>
</div>
