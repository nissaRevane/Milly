<%#
  The weight of real estate in the patrimoine, aggregated by usage.
  +totals+ is ordered: the usage buckets first, then nil for the "non rattaché"
  bucket when it has lines, then the :total row last.

  +totals+ always carries its :total row, even on a sheet without a single real
  estate line, so emptiness is decided on +positions+ instead.
%>
<% if positions.any? %>
  <div class="section property-usage-totals">
    <div class="section-header">
      <h2><%= t("views.balance_sheets.properties.usage_title") %></h2>
    </div>

    <div class="table-scroll">
      <table class="table table-compact">
        <thead>
          <tr>
            <th><%= t("views.balance_sheets.properties.usage") %></th>
            <th class="text-right"><%= t("views.balance_sheets.properties.gross") %></th>
            <th class="text-right"><%= t("views.balance_sheets.properties.debt") %></th>
            <th class="text-right"><%= t("views.balance_sheets.properties.net") %></th>
            <th class="text-right"><%= t("views.balance_sheets.properties.ltv") %></th>
          </tr>
        </thead>
        <tbody>
          <% totals.except(:total).each do |usage, total| %>
            <tr>
              <td>
                <span class="badge <%= usage ? "badge-secondary" : "badge-warning" %>">
                  <%= property_bucket_label(usage) %>
                </span>
              </td>
              <td class="text-right"><%= number_to_currency(total.gross) %></td>
              <td class="text-right"><%= number_to_currency(total.debt) %></td>
              <td class="text-right"><%= number_to_currency(total.net) %></td>
              <td class="text-right"><%= ltv_label(total.ltv) %></td>
            </tr>
          <% end %>

          <%# The overall LTV is deliberately nil — see BalanceSheet#real_estate_totals_by_usage %>
          <tr class="table-subtotal property-totals-row">
            <td><%= t("views.balance_sheets.properties.total") %></td>
            <td class="text-right"><%= number_to_currency(totals[:total].gross) %></td>
            <td class="text-right"><%= number_to_currency(totals[:total].debt) %></td>
            <td class="text-right"><%= number_to_currency(totals[:total].net) %></td>
            <td class="text-right"><%= ltv_label(totals[:total].ltv) %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <%# Collapsed by default: the usage weights are the headline, the per-bien detail the drill-down %>
    <details class="summary-category">
      <summary class="summary-category-header">
        <span class="summary-category-label">
          <span class="badge badge-secondary"><%= t("views.balance_sheets.properties.detail") %></span>
          <%# Counts biens, not rows: the unassigned bucket is not a bien %>
          <span class="summary-category-count"><%= positions.count { |position| !position.unassigned? } %></span>
        </span>
        <span class="summary-category-amount"><%= number_to_currency(totals[:total].net) %></span>
      </summary>

      <table class="table table-compact">
        <tbody>
          <% positions.each do |position| %>
            <tr>
              <td>
                <% if position.unassigned? %>
                  <%= t("views.balance_sheets.properties.unassigned") %>
                  <span class="badge badge-warning"><%= t("views.balance_sheets.properties.to_link") %></span>
                <% else %>
                  <%= position.property.name %>
                  <span class="badge badge-secondary"><%= position.property.usage_label %></span>
                <% end %>
              </td>
              <td class="text-right"><%= number_to_currency(position.gross) %></td>
              <td class="text-right"><%= number_to_currency(position.debt) %></td>
              <td class="text-right"><%= number_to_currency(position.net) %></td>
              <td class="text-right"><%= ltv_label(position.ltv) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </details>
  </div>
<% end %>
