<%# Steps to the neighbouring bilans keeping the tab the user is reading. Absent neighbours
    stay in the DOM as disabled spans so the title never shifts sideways between bilans. %>
<% tab_param = (@tab unless @tab == "general") %>
<div class="page-header">
  <div class="summary-nav">
    <% if @previous %>
      <%= link_to "‹",
                  summary_balance_sheet_path(@previous, tab: tab_param),
                  class: "summary-nav-arrow",
                  rel: "prev",
                  title: t("views.balance_sheets.summary.previous_sheet", date: l(@previous.closing_date, format: :long)),
                  "aria-label" => t("views.balance_sheets.summary.previous_sheet", date: l(@previous.closing_date, format: :long)) %>
    <% else %>
      <span class="summary-nav-arrow summary-nav-arrow-disabled"
            aria-hidden="true"
            title="<%= t("views.balance_sheets.summary.no_previous_sheet") %>">‹</span>
    <% end %>

    <div class="summary-nav-title">
      <h1><%= t("views.balance_sheets.summary.title", date: l(@balance_sheet.closing_date, format: :long)) %></h1>
      <%# Names the bilan every variation on the page is read against; absent on the first one. %>
      <% if @previous %>
        <p class="page-header-hint">
          <%= t("views.balance_sheets.summary.compared_to", date: l(@previous.closing_date, format: :long)) %>
        </p>
      <% end %>
    </div>

    <% if @following %>
      <%= link_to "›",
                  summary_balance_sheet_path(@following, tab: tab_param),
                  class: "summary-nav-arrow",
                  rel: "next",
                  title: t("views.balance_sheets.summary.next_sheet", date: l(@following.closing_date, format: :long)),
                  "aria-label" => t("views.balance_sheets.summary.next_sheet", date: l(@following.closing_date, format: :long)) %>
    <% else %>
      <span class="summary-nav-arrow summary-nav-arrow-disabled"
            aria-hidden="true"
            title="<%= t("views.balance_sheets.summary.no_next_sheet") %>">›</span>
    <% end %>
  </div>
</div>

<%# Server-rendered tabs: plain links carrying a ?tab= param, Turbo Drive does the rest %>
<nav class="tab-nav">
  <%= link_to t("views.balance_sheets.summary.tabs.general"),
              summary_balance_sheet_path(@balance_sheet),
              class: "tab-link#{" tab-link-active" if @tab == "general"}",
              "aria-current" => ("page" if @tab == "general") %>
  <%= link_to t("views.balance_sheets.summary.tabs.real_estate"),
              summary_balance_sheet_path(@balance_sheet, tab: "real_estate"),
              class: "tab-link#{" tab-link-active" if @tab == "real_estate"}",
              "aria-current" => ("page" if @tab == "real_estate") %>
</nav>

<% if @tab == "real_estate" %>
  <% if @property_positions.any? %>
    <%= render "real_estate_table",
                positions: @property_positions,
                totals: @real_estate_usage_totals,
                variation: @real_estate_variation %>
  <% else %>
    <p class="empty-state"><%= t("views.balance_sheets.properties.empty") %></p>
  <% end %>
<% else %>
  <%= render "summary_general" %>
<% end %>

<div class="form-actions">
  <%= link_to t("views.balance_sheets.summary.back"), balance_sheet_path(@balance_sheet), class: "btn btn-outline" %>
</div>
