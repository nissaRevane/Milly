<%# The arrows keep the tab the user is reading. %>
<% tab_param = (@tab unless @tab == "general") %>
<div class="page-header">
  <%= render layout: "balance_sheets/sheet_nav",
             locals: { previous: @previous,
                       following: @following,
                       previous_path: (summary_balance_sheet_path(@previous, tab: tab_param) if @previous),
                       following_path: (summary_balance_sheet_path(@following, tab: tab_param) if @following),
                       scope: "views.balance_sheets.summary" } do %>
    <h1><%= t("views.balance_sheets.summary.title", date: l(@balance_sheet.closing_date, format: :long)) %></h1>
    <%# Names the bilan every variation on the page is read against; absent on the first one. %>
    <% if @previous %>
      <p class="page-header-hint">
        <%= t("views.balance_sheets.summary.compared_to", date: l(@previous.closing_date, format: :long)) %>
      </p>
    <% end %>
  <% end %>
  <div class="page-header-actions">
    <%# La synthèse est le bilan tel qu'on le lit ; le détail est là où on le corrige. %>
    <%= link_to "✎",
                balance_sheet_path(@balance_sheet),
                class: "icon-btn",
                title: t("views.balance_sheets.summary.edit"),
                "aria-label" => t("views.balance_sheets.summary.edit") %>
  </div>
</div>

<%# Server-rendered tabs: plain links carrying a ?tab= param, Turbo Drive does the rest %>
<nav class="tab-nav">
  <%= link_to t("views.balance_sheets.summary.tabs.general"),
              summary_balance_sheet_path(@balance_sheet),
              class: "tab-link#{" tab-link-active" if @tab == "general"}",
              "aria-current" => ("page" if @tab == "general") %>
  <%= link_to t("views.balance_sheets.summary.tabs.real_estate"),
              summary_balance_sheet_path(@balance_sheet, tab: "real_estate"),
              class: "tab-link#{" tab-link-active" if @tab == "real_estate"}",
              "aria-current" => ("page" if @tab == "real_estate") %>
  <%= link_to t("views.balance_sheets.summary.tabs.dashboard"),
              summary_balance_sheet_path(@balance_sheet, tab: "dashboard"),
              class: "tab-link#{" tab-link-active" if @tab == "dashboard"}",
              "aria-current" => ("page" if @tab == "dashboard") %>
</nav>

<% case @tab %>
<% when "real_estate" %>
  <% if @property_positions.any? %>
    <%= render "real_estate_table",
                positions: @property_positions,
                totals: @real_estate_usage_totals,
                variation: @real_estate_variation %>
  <% else %>
    <p class="empty-state"><%= t("views.balance_sheets.properties.empty") %></p>
  <% end %>
<% when "dashboard" %>
  <%= render "summary_dashboard" %>
<% else %>
  <%= render "summary_general" %>
<% end %>
