<%#
  L'onglet graphiques : les chiffres de la synthèse, lus en formes plutôt qu'en tableaux.

  Rien n'y est calculé qui ne le soit déjà ailleurs — mêmes regroupements, mêmes variations,
  mêmes totaux immobiliers. Un anneau et un tableau du même bilan ne peuvent donc pas dire
  deux choses différentes.

  Les deux anneaux découpent le bilan sur les catégories du tableau de bord d'accueil, et
  en reprennent donc les couleurs : le vert des liquidités ou le gris d'un crédit immobilier
  nomment le même poste ici et là-bas.

  Le total des actifs et celui de la dette se lisent AU CENTRE de leur anneau, avec leurs
  deux variations : une tuile qui les répétait au-dessus disait le même chiffre deux fois, et
  prenait la largeur qui manquait aux anneaux. Ne reste en tête que les fonds propres, qui
  ne sont l'objet d'aucun des deux.
%>
<div class="stat-grid">
  <div class="stat-card stat-card-highlight">
    <span class="stat-label"><%= t("views.balance_sheets.summary.equity") %></span>
    <span class="stat-value"><%= number_to_currency(@balance_sheet.equity) %></span>
    <span class="stat-hint">
      <%= t("views.balance_sheets.summary.charts.since_previous") %>
      <%= @variations ? variation_note(@variations[:equity]) : t("views.balance_sheets.summary.charts.no_previous") %>
    </span>
    <span class="stat-hint">
      <%= t("views.balance_sheets.summary.charts.over_a_year") %>
      <%= @yearly_variations ? variation_note(@yearly_variations[:equity]) : t("views.balance_sheets.summary.charts.no_year_ago") %>
    </span>
  </div>
</div>

<div class="chart-grid">
  <section class="chart-card">
    <h2 class="chart-title"><%= t("views.balance_sheets.summary.charts.assets_by_type") %></h2>
    <%= donut_chart(breakdown_slices(@assets_breakdown),
                    center: donut_center(@balance_sheet.total_assets, [
                      [t("views.balance_sheets.summary.charts.since_previous"), @variations && @variations[:assets]],
                      [t("views.balance_sheets.summary.charts.over_a_year"), @yearly_variations && @yearly_variations[:assets]]
                    ])) ||
          tag.p(t("views.balance_sheets.summary.charts.no_assets"), class: "empty-state") %>
  </section>

  <section class="chart-card">
    <h2 class="chart-title"><%= t("views.balance_sheets.summary.charts.liabilities_by_type") %></h2>
    <%# La dette qui baisse est la bonne nouvelle : la couleur suit ce sens-là, pas le signe. %>
    <%= donut_chart(breakdown_slices(@liabilities_breakdown),
                    center: donut_center(@balance_sheet.total_liabilities, [
                      [t("views.balance_sheets.summary.charts.since_previous"), @variations && @variations[:liabilities]],
                      [t("views.balance_sheets.summary.charts.over_a_year"), @yearly_variations && @yearly_variations[:liabilities]]
                    ], favorable: :down)) ||
          tag.p(t("views.balance_sheets.summary.charts.no_liabilities"), class: "empty-state") %>
  </section>
</div>

<% if @property_positions.any? %>
  <section class="chart-card">
    <h2 class="chart-title"><%= t("views.balance_sheets.summary.charts.real_estate") %></h2>
    <p class="chart-hint"><%= t("views.balance_sheets.summary.charts.real_estate_hint") %></p>
    <%# Le bien se lit d'un seul regard : sa dette à gauche, sa valeur à droite, et entre les
        deux ce qu'il pèse vraiment. Le brut et la dette bougent chacun pour leurs raisons,
        et l'écart qu'ils laissent est la seule chose qui appartienne au propriétaire. %>
    <%= property_balance_bars(@property_positions) %>
  </section>
<% end %>
