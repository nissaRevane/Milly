<div class="summary-grid">
  <!-- Assets Column -->
  <div class="summary-column summary-column-assets">
    <h2 class="summary-column-title"><%= t("views.balance_sheets.summary.assets_column") %></h2>

    <div class="summary-categories">
      <% Asset.asset_types.keys.each do |type| %>
        <% items = @assets_by_type.fetch(type, []) %>
        <% next if items.empty? %>

        <details class="summary-category">
          <summary class="summary-category-header">
            <span class="summary-category-label">
              <span class="badge badge-secondary"><%= asset_type_label(type) %></span>
              <span class="summary-category-count"><%= items.size %></span>
            </span>
            <span class="summary-category-amount"><%= number_to_currency(items.sum(&:owned_value)) %></span>
          </summary>

          <table class="table table-compact">
            <tbody>
              <% items.each do |bsa| %>
                <tr>
                  <td>
                    <%= bsa.asset.name %>
                    <% unless bsa.asset.full_ownership? %>
                      <span class="badge badge-secondary"><%= ownership_share_label(bsa.asset.ownership_share) %></span>
                    <% end %>
                  </td>
                  <td class="text-right"><%= number_to_currency(bsa.owned_value) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </details>
      <% end %>
    </div>

    <div class="summary-risk-section">
      <% if @assets_by_risk.any? %>
        <div class="summary-risk-group">
          <h3 class="summary-risk-title"><%= t("views.balance_sheets.summary.risk_breakdown") %></h3>
          <table class="table table-compact">
            <tbody>
              <% %w[low medium high].each do |level| %>
                <% items = @assets_by_risk.fetch(level, []) %>
                <% next if items.empty? %>
                <tr>
                  <td><span class="badge <%= risk_level_badge_class(level) %>"><%= risk_level_label(level) %></span></td>
                  <td class="text-right"><%= number_to_currency(items.sum(&:owned_value)) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <div class="summary-total summary-total-assets">
      <span><%= t("views.balance_sheets.summary.total_assets") %></span>
      <span><%= number_to_currency(@balance_sheet.total_assets) %></span>
    </div>
  </div>

  <!-- Liabilities Column -->
  <div class="summary-column summary-column-liabilities">
    <h2 class="summary-column-title"><%= t("views.balance_sheets.summary.liabilities_column") %></h2>

    <div class="summary-categories">
      <% Liability.liability_types.keys.each do |type| %>
        <% items = @liabilities_by_type.fetch(type, []) %>
        <% next if items.empty? %>

        <details class="summary-category">
          <summary class="summary-category-header">
            <span class="summary-category-label">
              <span class="badge badge-secondary"><%= liability_type_label(type) %></span>
              <span class="summary-category-count"><%= items.size %></span>
            </span>
            <span class="summary-category-amount"><%= number_to_currency(items.sum(&:owned_remaining_capital)) %></span>
          </summary>

          <table class="table table-compact">
            <tbody>
              <% items.each do |bsl| %>
                <tr>
                  <td>
                    <%= bsl.liability.name %>
                    <% unless bsl.liability.full_ownership? %>
                      <span class="badge badge-secondary"><%= ownership_share_label(bsl.liability.ownership_share) %></span>
                    <% end %>
                  </td>
                  <td class="text-right"><%= number_to_currency(bsl.owned_remaining_capital) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </details>
      <% end %>
    </div>

    <div class="summary-risk-section">
      <% if @liabilities_by_risk.any? %>
        <div class="summary-risk-group">
          <h3 class="summary-risk-title"><%= t("views.balance_sheets.summary.risk_breakdown") %></h3>
          <table class="table table-compact">
            <tbody>
              <% %w[low medium high].each do |level| %>
                <% items = @liabilities_by_risk.fetch(level, []) %>
                <% next if items.empty? %>
                <tr>
                  <td><span class="badge <%= risk_level_badge_class(level) %>"><%= risk_level_label(level) %></span></td>
                  <td class="text-right"><%= number_to_currency(items.sum(&:owned_remaining_capital)) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <div class="summary-total summary-total-liabilities">
      <span><%= t("views.balance_sheets.summary.total_liabilities") %></span>
      <span><%= number_to_currency(@balance_sheet.total_liabilities) %></span>
    </div>
  </div>
</div>

<!-- Equity Summary -->
<div class="equity-box <%= @balance_sheet.equity >= 0 ? 'equity-positive' : 'equity-negative' %>">
  <span class="equity-label"><%= t("views.balance_sheets.summary.equity") %></span>
  <span class="equity-value"><%= number_to_currency(@balance_sheet.equity) %></span>
</div>
