<%= form_with(model: asset, class: "form") do |f| %>
  <% if asset.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% asset.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.assets.form.name") %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <%#
    Ce formulaire ne sert plus qu'à la création, la fiche portant elle-même la modification
    (voir assets#show) : rien n'y est jamais en lecture seule. « Immobilier » n'y est pas
    offert — c'est la création d'un bien qui produit ce type, et rien d'autre — et le
    rattachement à un bien ne s'y saisit pas non plus, pour la même raison.
  %>
  <div class="form-group">
    <%= f.label :asset_type, t("views.assets.form.asset_type") %>
    <%= f.select :asset_type, selectable_asset_type_options, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :ownership_share, t("views.assets.form.ownership_share") %>
    <%= f.number_field :ownership_share, step: 0.01, min: 0, max: 100, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :risk_level, t("views.assets.form.risk_level") %>
    <%= f.select :risk_level, risk_level_options, {}, class: "form-control" %>
  </div>

  <%= render "shared/lifespan_fields", f: f %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", assets_path, class: "btn btn-outline" %>
  </div>
<% end %>
