<%= form_with(model: asset, class: "form") do |f| %>
  <% if asset.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% asset.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.assets.form.name") %>
    <%# The name of the actif of a bien is the name of the bien, renamed with it %>
    <% if asset.owned_by_property? %>
      <%= f.text_field :name, class: "form-control", disabled: true %>
      <small class="form-hint"><%= t("views.assets.form.name_from_property") %></small>
    <% else %>
      <%= f.text_field :name, class: "form-control", required: true %>
    <% end %>
  </div>

  <%# "Immobilier" is never offered and never left: it is what creating a bien produces %>
  <div class="form-group">
    <% if asset.real_estate? %>
      <%= label_tag :asset_type_label, t("views.assets.form.asset_type") %>
      <%= text_field_tag :asset_type_label, asset.asset_type_label, class: "form-control", disabled: true %>
      <small class="form-hint"><%= t("views.assets.form.asset_type_locked") %></small>
    <% else %>
      <%= f.label :asset_type, t("views.assets.form.asset_type") %>
      <%= f.select :asset_type, selectable_asset_type_options, {}, class: "form-control" %>
    <% end %>
  </div>

  <%# Only offered once the user has declared a property — an empty select would just puzzle %>
  <% if asset.owned_by_property? %>
    <div class="form-group">
      <%= label_tag :property_name, t("views.assets.form.property") %>
      <%= text_field_tag :property_name, asset.property.name, class: "form-control", disabled: true %>
    </div>
  <% elsif @properties.any? && !asset.real_estate? %>
    <div class="form-group">
      <%= f.label :property_id, t("views.assets.form.property") %>
      <%= f.collection_select :property_id, @properties, :id, :name,
          { include_blank: t("views.assets.form.property_none") }, class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :ownership_share, t("views.assets.form.ownership_share") %>
    <%= f.number_field :ownership_share, step: 0.01, min: 0, max: 100, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :risk_level, t("views.assets.form.risk_level") %>
    <%= f.select :risk_level, risk_level_options, {}, class: "form-control" %>
  </div>

  <%= render "shared/lifespan_fields", f: f %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", assets_path, class: "btn btn-outline" %>
  </div>
<% end %>
