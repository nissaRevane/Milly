<%= form_with(model: asset, class: "form") do |f| %>
  <% if asset.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% asset.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.assets.form.name") %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :asset_type, t("views.assets.form.asset_type") %>
    <%= f.select :asset_type, asset_type_options, {}, class: "form-control" %>
  </div>

  <%# Only offered once the user has declared a property — an empty select would just puzzle %>
  <% if @properties.any? %>
    <div class="form-group">
      <%= f.label :property_id, t("views.assets.form.property") %>
      <%= f.collection_select :property_id, @properties, :id, :name,
          { include_blank: t("views.assets.form.property_none") }, class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :ownership_share, t("views.assets.form.ownership_share") %>
    <%= f.number_field :ownership_share, step: 0.01, min: 0, max: 100, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :risk_level, t("views.assets.form.risk_level") %>
    <%= f.select :risk_level, risk_level_options, {}, class: "form-control" %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", assets_path, class: "btn btn-outline" %>
  </div>
<% end %>
