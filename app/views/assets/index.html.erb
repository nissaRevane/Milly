<div class="page-header">
  <h1><%= t("views.assets.index.title") %></h1>
  <%= link_to t("views.assets.index.new"), new_asset_path, class: "btn btn-primary" %>
</div>

<% if @assets.any? || @asset_type_filter %>
  <%= form_with url: assets_path, method: :get, class: "filters",
      data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :asset_type, t("views.assets.index.filter_type") %>
      <%= f.select :asset_type, asset_type_options, { include_blank: t("views.assets.index.filter_all"), selected: @asset_type_filter },
          class: "form-control" %>
    </div>
    <noscript><%= f.submit t("views.assets.index.filter_submit"), class: "btn btn-outline" %></noscript>
  <% end %>
<% end %>

<% if @assets.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= t("views.assets.form.name") %></th>
        <th><%= t("views.assets.form.asset_type") %></th>
        <th class="text-right"><%= t("views.assets.index.ownership_share") %></th>
        <th class="table-actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @assets.each do |asset| %>
        <tr>
          <td><%= asset.name %></td>
          <td>
            <span class="badge <%= risk_level_badge_class(asset.risk_level) %>" title="<%= risk_level_label(asset.risk_level) %>">
              <%= asset.asset_type_label %>
            </span>
          </td>
          <td class="text-right"><%= ownership_share_label(asset.ownership_share) %></td>
          <td class="table-actions">
            <%= link_to "✏️", edit_asset_path(asset), class: "btn btn-sm btn-outline" %>
            <%# The actif of a bien is deleted from the bien, so it keeps no delete button here %>
            <% unless asset.owned_by_property? %>
              <%= button_to "🗑️", asset_path(asset), method: :delete, class: "btn btn-sm btn-danger",
                  form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t(@asset_type_filter ? "views.assets.index.empty_filtered" : "views.assets.index.empty") %></p>
<% end %>
