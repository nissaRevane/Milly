<div class="page-header">
  <h1><%= t("views.assets.index.title") %></h1>
  <%= link_to t("views.assets.index.new"), new_asset_path, class: "btn btn-primary" %>
</div>

<% if @assets.any? || @category_filter %>
  <%= form_with url: assets_path, method: :get, class: "filters",
      data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :category, t("views.assets.index.filter_category") %>
      <%= f.select :category, asset_category_options, { include_blank: t("views.assets.index.filter_all"), selected: @category_filter },
          class: "form-control" %>
    </div>
    <noscript><%= f.submit t("views.assets.index.filter_submit"), class: "btn btn-outline" %></noscript>
  <% end %>
<% end %>

<% if @assets.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= t("views.assets.form.name") %></th>
        <th><%= t("views.assets.index.category") %></th>
        <th class="text-right"><%= t("views.assets.index.ownership_share") %></th>
        <th class="table-actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @assets.each do |asset| %>
        <%# La ligne mène à la fiche, qui est aussi là qu'on modifie l'actif : plus de crayon
            vers une page de saisie séparée. %>
        <tr>
          <td><%= link_to asset.name, asset_path(asset), class: "row-link" %></td>
          <td>
            <%= link_to asset_path(asset), class: "row-link" do %>
              <%= category_badge(asset.category_key) %>
            <% end %>
          </td>
          <td class="text-right">
            <%= link_to ownership_share_label(asset.ownership_share), asset_path(asset), class: "row-link" %>
          </td>
          <td class="table-actions">
            <%# The actif of a bien is deleted from the bien, so it keeps no delete button here %>
            <% unless asset.owned_by_property? %>
              <%= button_to "🗑️", asset_path(asset), method: :delete, class: "btn btn-sm btn-danger",
                  form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t(@category_filter ? "views.assets.index.empty_filtered" : "views.assets.index.empty") %></p>
<% end %>
