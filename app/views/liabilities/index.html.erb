<div class="page-header">
  <h1><%= t("views.liabilities.index.title") %></h1>
  <%= link_to t("views.liabilities.index.new"), new_liability_path, class: "btn btn-primary" %>
</div>

<% if @liabilities.any? || @liability_type_filter %>
  <%= form_with url: liabilities_path, method: :get, class: "filters",
      data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :liability_type, t("views.liabilities.index.filter_type") %>
      <%= f.select :liability_type, liability_type_options, { include_blank: t("views.liabilities.index.filter_all"), selected: @liability_type_filter },
          class: "form-control" %>
    </div>
    <noscript><%= f.submit t("views.liabilities.index.filter_submit"), class: "btn btn-outline" %></noscript>
  <% end %>
<% end %>

<% if @liabilities.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= t("views.liabilities.form.name") %></th>
        <th><%= t("views.liabilities.form.liability_type") %></th>
        <th class="text-right"><%= t("views.liabilities.index.ownership_share") %></th>
        <th class="table-actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @liabilities.each do |liability| %>
        <tr>
          <td><%= link_to liability.name, liability_path(liability) %></td>
          <td>
            <span class="badge <%= risk_level_badge_class(liability.risk_level) %>" title="<%= risk_level_label(liability.risk_level) %>">
              <%= liability.liability_type_label %>
            </span>
          </td>
          <td class="text-right"><%= ownership_share_label(liability.ownership_share) %></td>
          <td class="table-actions">
            <%= link_to "✏️", edit_liability_path(liability), class: "btn btn-sm btn-outline" %>
            <%= button_to "🗑️", liability_path(liability), method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t(@liability_type_filter ? "views.liabilities.index.empty_filtered" : "views.liabilities.index.empty") %></p>
<% end %>
