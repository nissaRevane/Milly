<div class="page-header">
  <h1><%= t("views.liabilities.index.title") %></h1>
  <%= link_to t("views.liabilities.index.new"), new_liability_path, class: "btn btn-primary" %>
</div>

<% if @liabilities.any? || @category_filter %>
  <%= form_with url: liabilities_path, method: :get, class: "filters",
      data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :category, t("views.liabilities.index.filter_category") %>
      <%= f.select :category, liability_category_options, { include_blank: t("views.liabilities.index.filter_all"), selected: @category_filter },
          class: "form-control" %>
    </div>
    <noscript><%= f.submit t("views.liabilities.index.filter_submit"), class: "btn btn-outline" %></noscript>
  <% end %>
<% end %>

<% if @liabilities.any? %>
  <table class="table">
    <thead>
      <tr>
        <th><%= t("views.liabilities.form.name") %></th>
        <th><%= t("views.liabilities.form.liability_type") %></th>
        <th class="text-right"><%= t("views.liabilities.index.ownership_share") %></th>
        <th class="table-actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @liabilities.each do |liability| %>
        <tr>
          <td><%= link_to liability.name, liability_path(liability), class: "row-link" %></td>
          <td>
            <%= link_to liability_path(liability), class: "row-link" do %>
              <%= category_badge(liability.category_key) %>
            <% end %>
          </td>
          <td class="text-right"><%= link_to ownership_share_label(liability.ownership_share), liability_path(liability), class: "row-link" %></td>
          <td class="table-actions">
            <%= button_to "🗑️", liability_path(liability), method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t(@category_filter ? "views.liabilities.index.empty_filtered" : "views.liabilities.index.empty") %></p>
<% end %>
