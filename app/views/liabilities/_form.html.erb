<%= form_with(model: liability, class: "form") do |f| %>
  <% if liability.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% liability.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.liabilities.form.name") %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :liability_type, t("views.liabilities.form.liability_type") %>
    <%= f.select :liability_type, liability_type_options, {}, class: "form-control" %>
  </div>

  <%# Only offered once the user has declared a property — an empty select would just puzzle %>
  <% if @properties.any? %>
    <div class="form-group">
      <%= f.label :property_id, t("views.liabilities.form.property") %>
      <%= f.collection_select :property_id, @properties, :id, :name,
          { include_blank: t("views.liabilities.form.property_none") }, class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :ownership_share, t("views.liabilities.form.ownership_share") %>
    <%= f.number_field :ownership_share, step: 0.01, min: 0, max: 100, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :risk_level, t("views.liabilities.form.risk_level") %>
    <%= f.select :risk_level, risk_level_options, {}, class: "form-control" %>
  </div>

  <%#
    Toujours affiché : la validation côté serveur réserve ces champs aux crédits
    immobiliers et impose le tout-ou-rien, inutile d'ajouter du JS pour cela.
  %>
  <fieldset class="form-fieldset">
    <legend><%= t("views.liabilities.form.amortization_legend") %></legend>
    <p class="form-hint"><%= t("views.liabilities.form.amortization_hint") %></p>

    <div class="form-group">
      <%= f.label :borrowed_capital, t("views.liabilities.form.borrowed_capital") %>
      <%= f.number_field :borrowed_capital, step: 0.01, min: 0, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :annual_rate, t("views.liabilities.form.annual_rate") %>
      <%= f.number_field :annual_rate, step: 0.001, min: 0, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :duration_months, t("views.liabilities.form.duration_months") %>
      <%= f.number_field :duration_months, step: 1, min: 1, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :monthly_payment, t("views.liabilities.form.monthly_payment") %>
      <%= f.number_field :monthly_payment, step: 0.01, min: 0, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :first_payment_on, t("views.liabilities.form.first_payment_on") %>
      <%= f.date_field :first_payment_on, class: "form-control" %>
      <small class="form-hint"><%= t("views.liabilities.form.first_payment_hint") %></small>
    </div>

    <div class="form-group">
      <%= f.label :first_payment_principal, t("views.liabilities.form.first_payment_principal") %>
      <%= f.number_field :first_payment_principal, step: 0.01, min: 0, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :first_payment_interest, t("views.liabilities.form.first_payment_interest") %>
      <%= f.number_field :first_payment_interest, step: 0.01, min: 0, class: "form-control" %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", liabilities_path, class: "btn btn-outline" %>
  </div>
<% end %>
