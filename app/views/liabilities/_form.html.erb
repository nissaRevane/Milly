<%= form_with(model: liability, class: "form", data: { controller: "conditional-fields" }) do |f| %>
  <% if liability.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% liability.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.liabilities.form.name") %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :liability_type, t("views.liabilities.form.liability_type") %>
    <%= f.select :liability_type, liability_type_options, {}, class: "form-control",
        data: { conditional_fields_target: "select", action: "change->conditional-fields#toggle" } %>
  </div>

  <%#
    Only offered once the user has declared a property — an empty select would just puzzle —
    et seulement pour les types qu'un bien porte réellement : un crédit immobilier ou un
    dépôt de garantie (masqué côté serveur aussi, pour éviter tout flash ; la validation du
    modèle reste le filet de sécurité).
  %>
  <% if @properties.any? %>
    <div class="form-group" data-conditional-fields-target="fields"
        data-conditional-fields-show-when="<%= property_linkable_liability_types %>"
        <%= "hidden" unless liability.property_linkable? %>>
      <%= f.label :property_id, t("views.liabilities.form.property") %>
      <%= f.collection_select :property_id, @properties, :id, :name,
          { include_blank: t("views.liabilities.form.property_none") }, class: "form-control" %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :ownership_share, t("views.liabilities.form.ownership_share") %>
    <%= f.number_field :ownership_share, step: 0.01, min: 0, max: 100, class: "form-control", required: true %>
  </div>

  <%= render "shared/lifespan_fields", f: f %>

  <%#
    Visible seulement pour les types de crédits qui s'amortissent (masqué côté serveur pour
    éviter tout flash) ; la validation modèle reste le filet de sécurité côté serveur.
  %>
  <fieldset class="form-fieldset" data-conditional-fields-target="fields"
      data-conditional-fields-show-when="<%= amortizable_liability_types %>"
      <%= "hidden" unless liability.amortizable_type? %>>
    <legend><%= t("views.liabilities.form.amortization_legend") %></legend>
    <p class="form-hint"><%= t("views.liabilities.form.amortization_hint") %></p>

    <%# Les mêmes champs que l'onglet Échéancier de la fiche, une seule fois. %>
    <%= render "amortization_fields", f: f %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", liabilities_path, class: "btn btn-outline" %>
  </div>
<% end %>
