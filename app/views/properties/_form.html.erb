<%= form_with(model: property, class: "form") do |f| %>
  <% if property.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("views.properties.form.name") %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :usage, t("views.properties.form.usage") %>
    <%= f.select :usage, property_usage_options, {}, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :address, t("views.properties.form.address") %>
    <%= f.text_field :address, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.label :purchase_price, t("views.properties.form.purchase_price") %>
    <%= f.number_field :purchase_price, step: 0.01, min: 0, class: "form-control" %>
    <p class="form-hint"><%= t("views.properties.form.purchase_price_hint") %></p>
  </div>

  <div class="form-group">
    <%= f.label :acquired_on, t("views.properties.form.acquired_on") %>
    <%= f.date_field :acquired_on, class: "form-control" %>
  </div>

  <%#
    Les deux dates du bien donnent leur période, par défaut, à ses actifs et à ses passifs :
    un bien vendu cesse d'être proposé aux bilans clos après la vente (voir Lifespanable).
  %>
  <div class="form-group">
    <%= f.label :sold_on, t("views.properties.form.sold_on") %>
    <%= f.date_field :sold_on, class: "form-control" %>
    <p class="form-hint"><%= t("views.properties.form.sold_on_hint") %></p>
  </div>

  <% if property.new_record? %>
    <p class="form-hint"><%= t("views.properties.form.asset_hint") %></p>
  <% end %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Annuler", properties_path, class: "btn btn-outline" %>
  </div>
<% end %>
