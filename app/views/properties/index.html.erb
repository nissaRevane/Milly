<div class="page-header">
  <h1><%= t("views.properties.index.title") %></h1>
  <%= link_to t("views.properties.index.new"), new_property_path, class: "btn btn-primary" %>
</div>

<% if @properties.any? %>
  <table class="table">
    <tbody>
      <% @properties.each do |property| %>
        <tr>
          <td>
            <div class="cell-title"><%= link_to property.name, property_path(property) %></div>
            <span class="badge badge-secondary"><%= property.usage_label %></span>
          </td>
          <td><%= property.address.presence || "—" %></td>
          <td class="text-right"><%= property.purchase_price ? number_to_currency(property.purchase_price) : "—" %></td>
          <td class="table-actions">
            <%= link_to "✏️", edit_property_path(property), class: "btn btn-sm btn-outline" %>
            <%= button_to "🗑️", property_path(property), method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t("views.properties.index.empty") %></p>
<% end %>
