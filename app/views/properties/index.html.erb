<div class="page-header">
  <h1><%= t("views.properties.index.title") %></h1>
  <%= link_to t("views.properties.index.new"), new_property_path, class: "btn btn-primary" %>
</div>

<% if @properties.any? %>
  <table class="table">
    <tbody>
      <% @properties.each do |property| %>
        <tr>
          <td>
            <%= link_to property_path(property), class: "row-link" do %>
              <div class="cell-title"><%= property.name %></div>
              <%= property_usage_badge(property.usage) %>
            <% end %>
          </td>
          <td><%= link_to property.address.presence || "—", property_path(property), class: "row-link" %></td>
          <td class="text-right"><%= link_to property.purchase_price ? number_to_currency(property.purchase_price, precision: 0) : "—", property_path(property), class: "row-link" %></td>
          <td class="table-actions">
            <%= link_to "✏️", edit_property_path(property), class: "btn btn-sm btn-outline" %>
            <%= button_to "🗑️", property_path(property), method: :delete, class: "btn btn-sm btn-danger",
                form: { data: { turbo_confirm: t("views.balance_sheets.show.confirm_delete") } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state"><%= t("views.properties.index.empty") %></p>
<% end %>
